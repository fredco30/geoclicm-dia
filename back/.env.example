# =====================================================
# geoclicMédia — back / variables d'environnement
# Copier en .env (jamais committé) et remplir.
# =====================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-en-dev-mais-obligatoire-en-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,media.geoclic.fr

# --- Base de données ---
# Dev via tunnel SSH: ssh -L 5432:localhost:5432 ubuntu@135.125.159.142
# Puis se connecter sur localhost:5432 (forwardé vers le PG du VPS).
# En prod sur le VPS: DB_HOST=localhost (PG local au VPS).
DB_NAME=geoclicmedia_db
DB_USER=geoclicmedia_user
DB_PASSWORD=remplir-mot-de-passe-fort
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Celery + cache) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Crawl partage Assistant / Agenda ---
# Garde serveur, pas une limite fonctionnelle des sources.
SHARED_CRAWL_HARD_LIMIT=5000
# 6 h : une synchronisation reutilise les pages plus recentes sans recrawl.
SHARED_CRAWL_FRESHNESS_SECONDS=21600

# --- CORS / front ---
CORS_ALLOWED_ORIGINS=http://localhost:3001,https://media.geoclic.fr
FRONTEND_URL=http://localhost:3001

# --- Médias ---
MEDIA_URL=/media/
MEDIA_ROOT=mediafiles

# --- GeoDjango sous Windows (optionnel, chemins vers QGIS/OSGeo) ---
# GDAL_LIBRARY_PATH=C:\Program Files\QGIS 3.40.14\bin\gdal312.dll
# GEOS_LIBRARY_PATH=C:\Program Files\QGIS 3.40.14\bin\geos_c.dll

# --- Sentry (prod, optionnel sprint 1) ---
SENTRY_DSN=

# --- Sprint 2+ : à remplir plus tard ---
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# BREVO_API_KEY=
# MAPTILER_API_KEY=

# --- Sprint 4+ : Stripe ---
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
